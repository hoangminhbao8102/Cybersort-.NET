@page "/"
@page "/course-registration"
@rendermode InteractiveServer
@using CourseRegistrationForm.Models

<PageTitle>Course Registration Form</PageTitle>

<main class="registration-card">
    <h1>Course Registration Form</h1>

    <EditForm Model="@registration" OnValidSubmit="@HandleValidSubmit" OnInvalidSubmit="@HandleInvalidSubmit">
        <DataAnnotationsValidator />

        <div class="form-group">
            <label for="fullName">Full Name <span>*</span></label>
            <InputText id="fullName" class="form-control"
                       @bind-Value="registration.FullName"
                       placeholder="Enter your full name" />
            <ValidationMessage For="@(() => registration.FullName)" />
        </div>

        <div class="form-group">
            <label for="email">Email <span>*</span></label>
            <InputText id="email" class="form-control"
                       @bind-Value="registration.Email"
                       placeholder="Enter your email" />
            <ValidationMessage For="@(() => registration.Email)" />
        </div>

        <div class="form-group">
            <label for="phone">Phone Number <span>*</span></label>
            <InputText id="phone" class="form-control"
                       @bind-Value="registration.PhoneNumber"
                       placeholder="Enter your phone number" />
            <ValidationMessage For="@(() => registration.PhoneNumber)" />
        </div>

        <div class="form-group">
            <label for="course">Select Course <span>*</span></label>
            <InputSelect id="course" class="form-control" @bind-Value="registration.Course">
                <option value="">Choose...</option>
                <option value="Web Development">Web Development</option>
                <option value="Mobile App Development">Mobile App Development</option>
                <option value="Data Science">Data Science</option>
                <option value="UI/UX Design">UI/UX Design</option>
                <option value="Digital Marketing">Digital Marketing</option>
            </InputSelect>
            <ValidationMessage For="@(() => registration.Course)" />
        </div>

        <div class="form-group">
            <label>Study Mode <span>*</span></label>
            <InputRadioGroup @bind-Value="registration.StudyMode" class="radio-group">
                <label class="radio-option">
                    <InputRadio Value="@("Online")" /> Online
                </label>
                <label class="radio-option">
                    <InputRadio Value="@("Offline")" /> Offline
                </label>
            </InputRadioGroup>
            <ValidationMessage For="@(() => registration.StudyMode)" />
        </div>

        <div class="form-group">
            <label for="startDate">Preferred Start Date <span>*</span></label>
            <InputDate id="startDate" class="form-control"
                       @bind-Value="registration.PreferredStartDate"
                       />
            <ValidationMessage For="@(() => registration.PreferredStartDate)" />
        </div>

        <div class="form-group">
            <label for="comments">Comments or Notes</label>
            <InputTextArea id="comments" class="form-control comments-box"
                           @bind-Value="registration.Comments"
                           placeholder="Enter any additional information" />
        </div>

        <div class="terms-group">
            <InputCheckbox id="terms" @bind-Value="registration.AgreeToTerms" />
            <label for="terms">I agree to the terms and conditions</label>
            <span class="required-star">*</span>
            <ValidationMessage For="@(() => registration.AgreeToTerms)" />
        </div>

        <button type="submit" class="submit-btn">Register</button>
    </EditForm>

    @if (isSubmitted)
    {
        <div class="success-message" role="status">
            Registration submitted successfully!
            <div class="submitted-details">
                <strong>Name:</strong> @registration.FullName<br />
                <strong>Course:</strong> @registration.Course<br />
                <strong>Study mode:</strong> @registration.StudyMode<br />
                <strong>Start date:</strong> @registration.PreferredStartDate?.ToString("dd/MM/yyyy")
            </div>
        </div>
    }
</main>

<style>
    .registration-card {
    width: min(100% - 32px, 390px);
    margin: 20px auto;
    padding: 24px;
    background: #fff;
    border: 1px solid #e2e5e9;
    border-radius: 6px;
    box-shadow: 0 1px 5px rgba(0, 0, 0, .04);
    font-family: Arial, Helvetica, sans-serif;
    color: #202124;
}

.registration-card h1 {
    margin: 0 0 10px;
    text-align: center;
    font-size: 13px;
    line-height: 1.3;
    font-weight: 700;
}

.form-group {
    margin-bottom: 8px;
}

.form-group > label {
    display: block;
    margin-bottom: 3px;
    font-size: 9px;
}

.form-group > label span {
    font-weight: 700;
}

.form-control {
    display: block;
    box-sizing: border-box;
    width: 100%;
    min-height: 20px;
    padding: 4px;
    border: 1px solid #d5dbe2;
    border-radius: 3px;
    background: #fff;
    color: #30343b;
    font: 9px Arial, Helvetica, sans-serif;
}

.form-control:focus {
    outline: none;
    border-color: #80bdff;
    box-shadow: 0 0 0 2px rgba(0, 123, 255, .12);
}

.comments-box {
    height: 56px;
    resize: vertical;
}

.validation-message {
    display: block;
    margin-top: 2px;
    color: #dc3545;
    font-size: 7px;
}

.radio-group {
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: 12px;
}

.radio-option {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    font-size: 9px;
}

.radio-option input {
    margin: 0;
}

.terms-group {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px;
    margin: 8px 0 12px;
    font-size: 8px;
}

.terms-group input {
    margin: 0;
}

.terms-group label {
    cursor: pointer;
}

.terms-group .validation-message {
    margin-top: 0;
}

.required-star {
    color: #dc3545;
}

.submit-btn {
    display: block;
    width: 100%;
    min-height: 20px;
    border: 0;
    border-radius: 2px;
    background: #28a745;
    color: #fff;
    font-size: 9px;
    font-weight: 700;
    cursor: pointer;
}

.submit-btn:hover {
    background: #218838;
}

.success-message {
    margin-top: 14px;
    padding: 10px;
    border-radius: 4px;
    background: #d4edda;
    color: #155724;
    font-size: 9px;
}

.submitted-details {
    margin-top: 6px;
    line-height: 1.6;
}

@@media (max-width: 420px) {
    .registration-card {
        padding: 20px 24px;
    }
}
</style>

@code {
    private CourseRegistrationModel registration = new();
    private bool isSubmitted;

    private void HandleValidSubmit()
    {
        isSubmitted = true;
    }

    private void HandleInvalidSubmit(EditContext context)
    {
        isSubmitted = false;
    }
}
